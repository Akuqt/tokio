<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>tokio</AssemblyName>

    <InstallerUrl Condition="'$(INSTALLER_URL)' != ''">$(INSTALLER_URL)</InstallerUrl>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <PublishDir>..\..\installer-out\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="InstallerUrl" Value="$(InstallerUrl)" />
    <TrimmerRootAssembly Include="Photino.NET" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <Target Name="BuildReactApp" BeforeTargets="BeforeBuild">
    <Exec Command="yarn build:installer:ui" WorkingDirectory="$(ProjectDir).." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="dist\index.html" LogicalName="UI.index.html" />
  </ItemGroup>

  <!-- NOTE: Third-party license notices, see THIRD_PARTY_NOTICES.txt. Keep them embedded. -->
  <ItemGroup>
    <EmbeddedResource Include="THIRD_PARTY_NOTICES.txt" LogicalName="Licenses.THIRD_PARTY_NOTICES.txt" />
    <EmbeddedResource Include="..\..\LICENSES\Apache-2.0.txt" LogicalName="Licenses.Apache-2.0.txt" />
    <EmbeddedResource Include="..\..\LICENSES\CC-BY-4.0.txt" LogicalName="Licenses.CC-BY-4.0.txt" />
  </ItemGroup>

  <!-- Self-contained publish ships the .NET runtime, so embed the notices of the runtime pack in use. -->
  <Target Name="EmbedRuntimeNotices" AfterTargets="ResolveFrameworkReferences" BeforeTargets="PrepareResources">
    <ItemGroup>
      <_NetCoreRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <PropertyGroup>
      <_NetCoreRuntimePackDir>@(_NetCoreRuntimePack->'%(PackageDirectory)')</_NetCoreRuntimePackDir>
    </PropertyGroup>
    <Error Condition="'$(_NetCoreRuntimePackDir)' == '' Or !Exists('$(_NetCoreRuntimePackDir)\THIRD-PARTY-NOTICES.TXT')" Text="Unable to find the .NET runtime pack notices to embed." />
    <ItemGroup>
      <EmbeddedResource Include="$(_NetCoreRuntimePackDir)\LICENSE.TXT" LogicalName="Licenses.dotnet-LICENSE.txt" />
      <EmbeddedResource Include="$(_NetCoreRuntimePackDir)\THIRD-PARTY-NOTICES.TXT" LogicalName="Licenses.dotnet-THIRD-PARTY-NOTICES.txt" />
    </ItemGroup>
  </Target>
</Project>